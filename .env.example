# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Which model provider to use: foundry (demo/submission) or github (free dev backup)
ITG_LLM_PROVIDER=foundry
ITG_LLM_TIMEOUT_S=30

# Azure AI Foundry: endpoint and key from the resource's "Keys and Endpoint" page,
# deployment name is the name you gave the model deployment (not the model name).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# GitHub Models: leave GITHUB_TOKEN blank to use `gh auth token`.
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
